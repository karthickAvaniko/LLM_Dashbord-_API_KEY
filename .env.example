# ===== Avaniko AI Gateway — Environment Config =====
# Copy this file to .env and fill in the actual values
# .env is git-ignored — never commit secrets

# ----- vLLM Server (RunPod) -----
# RunPod public proxy URL for port 8000.
# Get it from: RunPod Console → Pods → your pod → Connect → "HTTP Service [Port 8000]"
# Format: https://<POD_ID>-8000.proxy.runpod.net  (NO trailing slash)
# Example: https://6picn4vdodn0ao-8000.proxy.runpod.net
VLLM_URL=https://YOUR_POD_ID-8000.proxy.runpod.net

# Must exactly match the --served-model-name flag used when starting vLLM
MODEL_NAME=qwen3.6-35b

# Friendly name shown in the UI / API responses
MODEL_DISPLAY_NAME=Qwen3.6-35B-A3B

# ----- Security -----
# Generate strong random strings for production (e.g., `openssl rand -hex 32`)
ADMIN_SECRET=change_this_to_random_secret
JWT_SECRET=change_this_to_random_jwt_secret
