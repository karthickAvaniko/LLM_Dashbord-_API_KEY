# ═══════════════════════════════════════════════════════════════
# Customer Backend Proxy — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the actual values

# Your Avaniko AI API key (kept secret on server, never sent to browser)
AVANIKO_API_KEY=ak_your_avaniko_key_here

# Avaniko API base URL
AVANIKO_BASE_URL=https://wo50dppqmt72bl-1111.proxy.runpod.net

# JWT secret for YOUR end users (generate: openssl rand -hex 32)
JWT_SECRET=replace_this_with_random_64_char_hex_string

# Cache TTL in seconds (3600 = 1 hour)
CACHE_TTL_SEC=3600

# Per-user rate limits
RATE_LIMIT_PER_MIN=30
RATE_LIMIT_PER_DAY=500
